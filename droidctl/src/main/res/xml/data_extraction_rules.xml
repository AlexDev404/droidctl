<?xml version="1.0" encoding="utf-8"?>
<!--
  DroidCtl holds adb pairing state and a list of Targets on the local network.
  None of it is meaningful on another device, and some of it is sensitive, so
  nothing is backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
